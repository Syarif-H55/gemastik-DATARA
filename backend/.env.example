# DATARA Backend - Environment Configuration
# Copy file ini ke `.env` lalu sesuaikan nilainya.
# Jangan commit `.env` ke repository.

# --- Database ---
# Koneksi MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@localhost:3306/datara

# Fallback terpisah (opsional, dipakai bila DATABASE_URL tidak diset).
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=datara

# --- CORS ---
# Origin frontend yang diizinkan (dipisahkan koma).
CORS_ORIGINS=http://localhost:3000

# --- Authentication (JWT) ---
# Secret acak untuk menandatangani access token (minimal 32 karakter).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- AI Business Assistant (LLM) ---
# Provider LLM (saat ini: gemini). Tanpa GEMINI_API_KEY, endpoint
# POST /api/v1/ai/chat mengembalikan error 502 dan frontend memakai
# balasan placeholder.
LLM_PROVIDER=gemini
# ISI API key Anda di file .env (JANGAN commit key ke repository)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Google OAuth (Sign in with Google) ---
# Client ID dari Google Cloud Console → Credentials → OAuth 2.0 Client
# (type: Web application). Tanpa ini, POST /auth/google menolak dengan 401.
# Authorized JavaScript origins: http://localhost:3000
GOOGLE_CLIENT_ID=

# --- Canonical API URL (untuk frontend) ---
# Business API DATARA memakai canonical prefix /api/v1.
# Frontend (NEXT_PUBLIC_API_URL) mengarah ke:
#   http://localhost:8000/api/v1
# Endpoint health tetap berada di luar versioning:
#   http://localhost:8000/api/health
#   http://localhost:8000/api/health/db

