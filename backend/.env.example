# DATARA Backend - Environment Configuration
# Copy ke .env dan sesuaikan nilainya.

# Koneksi MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/datara

# Fallback terpisah (opsional, dipakai bila DATABASE_URL tidak diset)
DB_USER=root
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=datara
